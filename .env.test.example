# Prefer ./scripts/test-bot.sh init, which creates independent random keys.
APP_ENV=test
ABS_MODE=mock
TELEGRAM_BOT_TOKEN=独立测试Bot的Token
TEST_BOT_USERNAME=独立测试Bot的用户名（不含@）
ADMIN_TELEGRAM_IDS=你的TG数字ID
TEST_DATA_DIR=data-test
DATABASE_URL=data-test/bot_data.db
# 私聊测试模式禁止开启入群验证或配置频道；群验证使用模拟 API 自动测试。
NOTICE_GROUP_ID=0
ANNOUNCEMENT_CHANNEL_ID=0
JOIN_VERIFY_ENABLED=false
JOIN_VERIFY_CHANNEL_ID=0
JOIN_VERIFY_CHANNEL_URL=
BACKUP_GROUP_ID=0
BACKUP_ENCRYPT_KEY=填写独立的64位随机密钥
SECURITY_PEPPER=填写另一个独立的64位随机密钥
INVITE_REQUIRED=false
WORKER_COUNT=4
QUEUE_CAPACITY=1000
DATABASE_MAX_OPEN_CONNS=1
DATABASE_MAX_IDLE_CONNS=1
